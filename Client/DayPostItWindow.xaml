<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Client.DayPostItWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Post-it du jour">
    <Grid x:Name="Root" Background="#FFF8B0" Padding="14,10,14,10" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock x:Name="FamilyText" Foreground="#3A3A3A" FontSize="12" TextWrapping="Wrap" />
            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MembersPanel" Orientation="Horizontal" Spacing="6" />
            </ScrollViewer>
        </StackPanel>
        <TextBox x:Name="NoteText" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"
                 Background="Transparent" BorderThickness="0" Foreground="Black"
                 PlaceholderText="Cotations du jour pour la famille (une seule saisie, visible dans le dossier de chacun)…"
                 TextChanged="NoteText_TextChanged" LostFocus="NoteText_LostFocus" />
        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#5A5A5A" FontSize="11" TextWrapping="Wrap" />
    </Grid>
</Window>
