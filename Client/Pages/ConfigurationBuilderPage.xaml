<Page
    x:Class="Client.Pages.ConfigurationBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:Client.Models"
    xmlns:helpers="using:Client.Helpers"
    x:Name="PageRoot"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <helpers:StringToColorConverter x:Key="StringToColorConverter"/>
    </Page.Resources>

    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="16">
        <StackPanel Spacing="12">
            <Button Content="← Retour" Click="Back_Click" HorizontalAlignment="Left"/>
            <TextBlock Text="Générateur de fichiers de configuration" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Préparez ici les utilisateurs, postes, examens et salles à déployer dans EyeChat." Opacity="0.75"/>
        </StackPanel>
        <muxc:TabView Grid.Row="1" IsAddTabButtonVisible="False">
            <muxc:TabViewItem Header="Utilisateurs">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Padding="4,12,12,12">
                        <TextBlock Text="Créez chaque utilisateur, paramétrez ses raccourcis d’en-tête puis exportez un fichier .eyechatusers importable depuis la page Système."
                                   TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="*,120" ColumnSpacing="12">
                            <TextBox x:Name="UserNameBox" Header="Nom de l'utilisateur" PlaceholderText="Ex. Dr Dupont"/>
                            <TextBox x:Name="InitialsBox" Grid.Column="1" Header="Initiales" MaxLength="4" PlaceholderText="DD"/>
                        </Grid>

                        <TextBlock Text="Raccourcis en-tête" FontSize="18" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="70,*,*,*,*" ColumnSpacing="8" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Réfraction" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Lentilles" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Pathologies" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Orthoptie" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="F5" VerticalAlignment="Center"/><TextBox x:Name="F5RefractionBox" Grid.Row="1" Grid.Column="1"/><TextBox x:Name="F5LentillesBox" Grid.Row="1" Grid.Column="2"/><TextBox x:Name="F5PathologiesBox" Grid.Row="1" Grid.Column="3"/><TextBox x:Name="F5OrthoptieBox" Grid.Row="1" Grid.Column="4"/>
                            <TextBlock Grid.Row="2" Text="F6" VerticalAlignment="Center"/><TextBox x:Name="F6RefractionBox" Grid.Row="2" Grid.Column="1"/><TextBox x:Name="F6LentillesBox" Grid.Row="2" Grid.Column="2"/><TextBox x:Name="F6PathologiesBox" Grid.Row="2" Grid.Column="3"/><TextBox x:Name="F6OrthoptieBox" Grid.Row="2" Grid.Column="4"/>
                            <TextBlock Grid.Row="3" Text="F7" VerticalAlignment="Center"/><TextBox x:Name="F7RefractionBox" Grid.Row="3" Grid.Column="1"/><TextBox x:Name="F7LentillesBox" Grid.Row="3" Grid.Column="2"/><TextBox x:Name="F7PathologiesBox" Grid.Row="3" Grid.Column="3"/><TextBox x:Name="F7OrthoptieBox" Grid.Row="3" Grid.Column="4"/>
                            <TextBlock Grid.Row="4" Text="F8" VerticalAlignment="Center"/><TextBox x:Name="F8RefractionBox" Grid.Row="4" Grid.Column="1"/><TextBox x:Name="F8LentillesBox" Grid.Row="4" Grid.Column="2"/><TextBox x:Name="F8PathologiesBox" Grid.Row="4" Grid.Column="3"/><TextBox x:Name="F8OrthoptieBox" Grid.Row="4" Grid.Column="4"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SaveUserButton" Content="Ajouter cet utilisateur" Click="AddUser_Click"/>
                            <Button x:Name="CancelUserEditButton" Content="Annuler la modification" Click="CancelUserEdit_Click" Visibility="Collapsed"/>
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind UserNames}" MaxHeight="160">
                            <ListView.ItemTemplate><DataTemplate x:DataType="x:String"><Grid ColumnDefinitions="*,Auto" Padding="0,3"><TextBlock Text="{x:Bind}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Modifier" Click="EditUser_Click" Tag="{x:Bind}"/></Grid></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="UserStatusText" TextWrapping="Wrap" Opacity="0.75"/>
                        <Button Content="Exporter le fichier utilisateurs" Click="ExportUsers_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </muxc:TabViewItem>

            <muxc:TabViewItem Header="Postes">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Padding="4,12,12,12">
                        <TextBlock Text="Créez les postes et leurs raccourcis examens F9 à F12, indépendamment des utilisateurs."
                                   TextWrapping="Wrap"/>
                        <TextBox x:Name="WorkstationNameBox" Header="Nom du poste" PlaceholderText="Ex. Consultation 1"/>
                        <TextBlock Text="Raccourcis examens" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Sélectionnez un examen existant pour chaque combinaison." Opacity="0.7"/>
                        <Grid ColumnDefinitions="72,*,*" ColumnSpacing="12" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Maj" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Ctrl" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="F9" VerticalAlignment="Center"/><ComboBox x:Name="ShiftF9Box" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Exams}" DisplayMemberPath="DisplayLabel" SelectedValuePath="Id"/><ComboBox x:Name="CtrlF9Box" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Exams}" DisplayMemberPath="DisplayLabel" SelectedValuePath="Id"/>
                            <TextBlock Grid.Row="2" Text="F10" VerticalAlignment="Center"/><ComboBox x:Name="ShiftF10Box" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Exams}" DisplayMemberPath="DisplayLabel" SelectedValuePath="Id"/><ComboBox x:Name="CtrlF10Box" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Exams}" DisplayMemberPath="DisplayLabel" SelectedValuePath="Id"/>
                            <TextBlock Grid.Row="3" Text="F11" VerticalAlignment="Center"/><ComboBox x:Name="ShiftF11Box" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Exams}" DisplayMemberPath="DisplayLabel" SelectedValuePath="Id"/><ComboBox x:Name="CtrlF11Box" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Exams}" DisplayMemberPath="DisplayLabel" SelectedValuePath="Id"/>
                            <TextBlock Grid.Row="4" Text="F12" VerticalAlignment="Center"/><ComboBox x:Name="ShiftF12Box" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Exams}" DisplayMemberPath="DisplayLabel" SelectedValuePath="Id"/><ComboBox x:Name="CtrlF12Box" Grid.Row="4" Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Exams}" DisplayMemberPath="DisplayLabel" SelectedValuePath="Id"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SaveWorkstationButton" Content="Ajouter ce poste" Click="AddWorkstation_Click"/><Button x:Name="CancelWorkstationEditButton" Content="Annuler la modification" Click="CancelWorkstationEdit_Click" Visibility="Collapsed"/></StackPanel>
                        <ListView ItemsSource="{x:Bind WorkstationNames}" MaxHeight="160"><ListView.ItemTemplate><DataTemplate x:DataType="x:String"><Grid ColumnDefinitions="*,Auto" Padding="0,3"><TextBlock Text="{x:Bind}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Modifier" Click="EditWorkstation_Click" Tag="{x:Bind}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                        <TextBlock x:Name="WorkstationStatusText" TextWrapping="Wrap" Opacity="0.75"/>
                        <Button Content="Exporter le fichier postes" Click="ExportWorkstations_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </muxc:TabViewItem>

            <muxc:TabViewItem Header="Examens">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Padding="4,12,12,12">
                        <TextBlock Text="Les examens existants sont chargés automatiquement depuis EyeChat. Modifiez directement leurs propriétés avant d’exporter la configuration des salles." TextWrapping="Wrap"/>
                        <Grid Width="1505" ColumnSpacing="5" Padding="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/><ColumnDefinition Width="210"/><ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="140"/><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="190"/><ColumnDefinition Width="250"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Nom" TextAlignment="Center"/><TextBlock Grid.Column="1" Text="Description" TextAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Couleur" TextAlignment="Center"/><TextBlock Grid.Column="3" Text="Code clavier" TextAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="Annotation" TextAlignment="Center"/><TextBlock Grid.Column="5" Text="Annotation de fin" TextAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="Salle" TextAlignment="Center"/><TextBlock Grid.Column="7" Text="Actions" TextAlignment="Center"/>
                        </Grid>
                        <ListView ItemsSource="{x:Bind Exams}" SelectionMode="None" MaxHeight="410" Width="1505" HorizontalAlignment="Left">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ExamOption">
                                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="5" Padding="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190"/><ColumnDefinition Width="210"/><ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="140"/><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/>
                                                <ColumnDefinition Width="190"/><ColumnDefinition Width="250"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{x:Bind Name, Mode=TwoWay}"/><TextBox Grid.Column="1" Text="{x:Bind Description, Mode=TwoWay}"/>
                                            <Button Grid.Column="2" HorizontalAlignment="Stretch">
                                                <Rectangle Width="32" Height="16" Fill="{x:Bind Color, Converter={StaticResource StringToColorConverter}}" Stroke="Black"/>
                                                <Button.Flyout><Flyout><ColorPicker Color="{x:Bind Color, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" ColorChanged="ExamColorPicker_ColorChanged"/></Flyout></Button.Flyout>
                                            </Button>
                                            <TextBox Grid.Column="3" Text="{x:Bind CodeMSG, Mode=TwoWay}"/><TextBox Grid.Column="4" Text="{x:Bind Annotation, Mode=TwoWay}"/>
                                            <TextBox Grid.Column="5" Text="{x:Bind EndAnnotation, Mode=TwoWay}"/>
                                            <ComboBox Grid.Column="6" HorizontalAlignment="Stretch" ItemsSource="{Binding Rooms, ElementName=PageRoot}" SelectedItem="{x:Bind Floor, Mode=TwoWay}"/>
                                            <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                                <Button Content="Dupliquer" Click="DuplicateExam_Click"/>
                                                <Button Content="↑" Click="MoveExamUp_Click" ToolTipService.ToolTip="Monter"/>
                                                <Button Content="↓" Click="MoveExamDown_Click" ToolTipService.ToolTip="Descendre"/>
                                                <Button Content="Supprimer" Click="DeleteExam_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Ajouter un examen" Click="AddExam_Click"/>
                            <Button Content="Importer un fichier existant" Click="ImportExams_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ExamStatusText" TextWrapping="Wrap" Opacity="0.75"/>
                    </StackPanel>
                </ScrollViewer>
            </muxc:TabViewItem>

            <muxc:TabViewItem Header="Salles">
                <StackPanel Spacing="14" Padding="4,12,12,12">
                    <TextBlock Text="Composez la liste des salles puis exportez un fichier .eyechatconfig importable depuis la page Examens."
                               TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox x:Name="RoomNameBox" PlaceholderText="Nom de la salle" KeyDown="RoomNameBox_KeyDown"/>
                        <Button Grid.Column="1" Content="Ajouter" Click="AddRoom_Click"/>
                    </Grid>
                    <ListView ItemsSource="{x:Bind Rooms}" Height="360">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Supprimer" Click="DeleteRoom_Click" Tag="{x:Bind}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="RoomStatusText" TextWrapping="Wrap" Opacity="0.75"/>
                    <Button Content="Exporter le fichier salles" Click="ExportRooms_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </muxc:TabViewItem>
        </muxc:TabView>
    </Grid>
</Page>
