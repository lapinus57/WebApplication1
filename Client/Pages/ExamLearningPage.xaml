<Page
    x:Class="Client.Pages.ExamLearningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="5">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Content="Retour à Préparation FO" Click="Back_Click"/>
                <TextBlock Text="Apprentissage local des examens" FontSize="26" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Text="Pour le prochain rendez-vous : FO, OCT, V3F et Skiacol. Relisez, répondez Oui ou Non et sélectionnez les passages qui expliquent votre choix." TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="8" Padding="0,0,0,5">
                <StackPanel Spacing="4"><TextBlock Text="Du"/><CalendarDatePicker x:Name="FromDate" Width="150"/></StackPanel>
                <StackPanel Spacing="4"><TextBlock Text="Au"/><CalendarDatePicker x:Name="ToDate" Width="150"/></StackPanel>
                <Button Content="Charger les patients" Click="Load_Click" VerticalAlignment="Bottom"/>
                <Button Content="Entraîner et tester" Click="Train_Click" VerticalAlignment="Bottom"/>
                <Button Content="Exporter le modèle" Click="Export_Click" VerticalAlignment="Bottom"/>
                <Button Content="Importer un modèle" Click="Import_Click" VerticalAlignment="Bottom"/>
                <Button Content="Activer le classement" Click="Activate_Click" VerticalAlignment="Bottom"/>
                <Button Content="Désactiver" Click="Disable_Click" VerticalAlignment="Bottom"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="4">
            <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Message="Chargez une période pour relire les dossiers. L’ouverture de cette page ne lance aucune connexion Access."/>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap"/>
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed"/>
        </StackPanel>
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBox x:Name="FilterText" PlaceholderText="Nom, identifiant ou À confirmer" TextChanged="Filter_Changed"/>
                <ListView x:Name="PatientsList" Grid.Row="1" SelectionChanged="Patient_Changed" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate><DataTemplate><StackPanel Spacing="5" Padding="6,10">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding AppointmentText}" FontSize="12"/>
                        <TextBlock Text="{Binding Classification}" TextWrapping="Wrap"/>
                    </StackPanel></DataTemplate></ListView.ItemTemplate>
                </ListView>
            </Grid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ReviewPanel" Spacing="10" IsEnabled="False">
                    <TextBlock x:Name="PatientTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Examens à préparer au prochain rendez-vous" FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="12" RowSpacing="8" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ComboBox x:Name="FoAnswer" Header="FO" Width="135"/>
                        <ComboBox x:Name="OctAnswer" Grid.Column="1" Header="OCT" Width="135"/>
                        <ComboBox x:Name="V3Answer" Grid.Row="1" Header="V3F" Width="135"/>
                        <ComboBox x:Name="SkiAnswer" Grid.Row="1" Grid.Column="1" Header="Skiacol" Width="135"/>
                    </Grid>
                    <TextBlock Text="Sélectionnez un passage dans le texte, choisissez l’examen, puis ajoutez cet extrait à votre réponse Oui/Non." TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="EvidenceExam" Width="135" SelectedIndex="0"/>
                        <Button Content="Ajouter la sélection comme explication" Click="AddEvidence_Click"/>
                    </StackPanel>
                    <TextBox x:Name="ConsultationText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220" MaxHeight="420"/>
                    <TextBlock x:Name="EvidenceText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    <Button Content="Effacer les extraits" Click="ClearEvidence_Click"/>
                    <Button Content="Enregistrer mes réponses et extraits" Click="SaveAnswers_Click" Style="{StaticResource AccentButtonStyle}"/>
                    <Expander Header="Pourquoi ce classement ?" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Expander Grid.Row="4" Header="Résultats des tests et modèle à exporter" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <ScrollViewer MaxHeight="260"><TextBlock x:Name="ModelReport" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer>
        </Expander>
    </Grid>
</Page>
