<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Client.Pages.FamilyCardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Client.SmsMail.Services">
    <Grid ColumnSpacing="20" Padding="24,16,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
 <ScrollViewer>
            <StackPanel Spacing="12" Padding="0,0,12,0">
                <TextBlock Text="Fiche famille" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Text="Fiche des rendez-vous à venir de toute la famille, à imprimer ou à envoyer par mail. Tapez un nom, un prénom ou une date de naissance, puis choisissez la personne." />
                <AutoSuggestBox x:Name="FamilyCardSearchBox" Header="Patient" PlaceholderText="Nom, prénom ou date de naissance (05/03/1980)" QueryIcon="Find"
                                TextChanged="FamilyCardSearch_TextChanged" QuerySubmitted="FamilyCardSearch_QuerySubmitted" />
                <ListView x:Name="FamilyCardResults" Header="Personnes trouvées" SelectionMode="Single" SelectionChanged="FamilyCardResults_SelectionChanged" MaxHeight="320">
                    <ListView.ItemTemplate><DataTemplate x:DataType="services:FamilyCardCandidate">
                        <TextBlock Text="{x:Bind Display}" TextWrapping="Wrap" Margin="0,6" />
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="FamilyCardMembersHeader" Text="Personnes sur la fiche (décochez pour retirer)" FontWeight="SemiBold" Visibility="Collapsed" />
                <StackPanel x:Name="FamilyCardMembersPanel" Spacing="2" />
                <TextBlock x:Name="FamilyCardStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.85" />
                <Button x:Name="FamilyCardPrintButton" Style="{StaticResource AccentButtonStyle}" Content="Imprimer la fiche" Click="FamilyCardPrint_Click" IsEnabled="False" />
                <ComboBox x:Name="FamilyCardEmailBox" Header="Envoyer par mail à" IsEditable="True" HorizontalAlignment="Stretch" PlaceholderText="adresse@exemple.fr" />
                <Button x:Name="FamilyCardMailButton" Content="Envoyer la fiche par mail" Click="FamilyCardMail_Click" IsEnabled="False" />
            </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <WebView2 x:Name="FamilyCardPreview" />
            </Border>
    </Grid>
</Page>
