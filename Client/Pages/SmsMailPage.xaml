<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Client.Pages.SmsMailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Client.SmsMail.Models"
    xmlns:services="using:Client.SmsMail.Services"
    xmlns:local="using:Client.Pages">
    <Page.Resources>
        <local:MailChannelVisibilityConverter x:Key="MailChannelVisibility" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>
    <Grid Padding="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="SMS et mail" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Préparez vos rappels, vérifiez les destinataires et envoyez en toute simplicité." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Pivot x:Name="Workspace" Grid.Row="1">
            <PivotItem Header="Envois">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <CommandBar Background="Transparent" DefaultLabelPosition="Right" HorizontalContentAlignment="Left">
                        <CommandBar.Content><CalendarDatePicker FirstDayOfWeek="Monday" x:Name="DayPicker" AutomationProperties.Name="Jour des rendez-vous" DateChanged="DayPicker_DateChanged" Margin="0,0,12,0" /></CommandBar.Content>
                        <AppBarButton Label="Charger et préparer" Icon="Download" Click="Load_Click" />
                        <AppBarButton Label="Exporter la liste (Excel)" Icon="Save" Click="ExportMessages_Click" />
                        <CommandBar.SecondaryCommands>
                            <AppBarButton Label="Préparer à nouveau" Icon="Refresh" Click="Prepare_Click" />
                            <AppBarButton Label="Tester mail / SMS" Click="TestSend_Click" />
                            <AppBarButton Label="Voir les horaires ajustés" Click="ReviewTimes_Click" />
                            <AppBarButton Label="Exporter un diagnostic chiffré" Click="ExportDiagnostic_Click" />
                            <AppBarButton Label="Exporter la configuration de ce poste" Click="ExportConfig_Click" />
                            <AppBarButton Label="Consulter le solde SMS" Click="Balance_Click" />
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                    <Grid Grid.Row="1" RowSpacing="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ComboBox x:Name="SendChannelFilter" AutomationProperties.Name="Filtrer les envois par canal" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="SendFilter_Changed">
                            <ComboBoxItem Content="Tous les messages" Tag="" /><ComboBoxItem Content="Mails" Tag="Mail" /><ComboBoxItem Content="SMS" Tag="SMS" />
                        </ComboBox>
                        <TextBox x:Name="SendSearch" Grid.Column="1" AutomationProperties.Name="Rechercher un destinataire" PlaceholderText="Rechercher un nom, une adresse mail ou un téléphone…" TextChanged="SendSearch_Changed" />
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="SmsFamilySizeFilter" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Nombre minimum de personnes pour envoyer un SMS" SelectionChanged="SmsFamilySize_Changed" ToolTipService.ToolTip="Personnes ayant un rendez-vous ce jour dans la famille regroupée. Le seuil ne limite pas les mails.">
                                <ComboBoxItem Content="SMS : 1 (toutes)" /><ComboBoxItem Content="SMS : 2 et plus" /><ComboBoxItem Content="SMS : 3+" />
                            </ComboBox>
                            <CheckBox x:Name="SmsOnlyNoEmail" Grid.Column="1" Content="Pas de SMS si la famille a un mail valide" Checked="Options_Changed" Unchecked="Options_Changed" />
                        </Grid>
                        <TextBlock x:Name="SummaryText" Grid.Row="2" Grid.ColumnSpan="2" Text="Choisissez un jour, puis chargez les rendez-vous." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Padding="12,12,28,12" Background="{ThemeResource ControlFillColorSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="86" /><ColumnDefinition Width="60" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="✓" AutomationProperties.Name="Sélection" />
                                <TextBlock Grid.Column="1" Text="Heure RDV ↑" FontWeight="SemiBold" TextWrapping="Wrap" ToolTipService.ToolTip="Tri croissant sur le premier horaire réel du rendez-vous de la famille" />
                                <TextBlock Grid.Column="2" Text="Canal" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Personnes" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="Destinataire" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="Regroupés par" FontWeight="SemiBold" ToolTipService.ToolTip="Ce qui relie les personnes réunies dans ce message" />
                                <TextBlock Grid.Column="6" Text="Résumé / message" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="7" Text="Statut" FontWeight="SemiBold" />
                            </Grid>
                            <ListView x:Name="MessagesList" Grid.Row="1" AutomationProperties.Name="Tableau des messages à envoyer" SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate><DataTemplate>
                                    <Border Padding="12,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Grid MinHeight="44"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="86" /><ColumnDefinition Width="60" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSend}" AutomationProperties.Name="{Binding Contact}" Checked="MessageSelection_Changed" Unchecked="MessageSelection_Changed" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1" Spacing="4" Margin="0,4,8,0">
                                                <TextBlock Text="{Binding AppointmentTimeDisplay}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ArrivalHint}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Channel}" FontWeight="SemiBold" Margin="0,4,8,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding PeopleDisplay}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,4,12,0" />
                                            <TextBlock Grid.Column="4" Text="{Binding Contact}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,4,12,0" />
                                            <TextBlock Grid.Column="5" Text="{Binding GroupingReason}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,12,0" />
                                            <StackPanel Grid.Column="6" Spacing="6" Margin="0,4,16,0">
                                                <TextBlock Text="{Binding TimeExplanation}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding TableSummary}" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="21" />
                                                <Button Background="Transparent" BorderThickness="0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Content="Détails du mail" FontSize="12" Padding="0" MinHeight="0" HorizontalAlignment="Left" Visibility="{Binding Channel, Converter={StaticResource MailChannelVisibility}}">
                                                    <Button.Flyout><Flyout Opening="MailDetails_Opening">
                                                        <ScrollViewer MaxHeight="420" MaxWidth="540">
                                                            <StackPanel Spacing="8">
                                                                <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding BodyDisplay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="21" />
                                                            </StackPanel>
                                                        </ScrollViewer>
                                                    </Flyout></Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Grid.Column="7" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate></ListView.ItemTemplate>
                            </ListView>
                            <StackPanel x:Name="EmptyMessagesPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Padding="24" IsHitTestVisible="False">
                                <FontIcon Glyph="&#xE8F2;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="EmptyMessagesText" Text="Vos messages apparaîtront ici" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="Chargez des rendez-vous ou ajustez les filtres." TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="SelectionSummary" Text="Aucun message sélectionné." FontWeight="SemiBold" TextWrapping="Wrap" />
                            <CommandBar Background="Transparent" DefaultLabelPosition="Right" HorizontalContentAlignment="Left">
                                <AppBarButton Label="Envoyer les mails" Icon="Mail" Click="SendMail_Click" />
                                <AppBarButton Label="Envoyer les SMS" Icon="Message" Click="SendSms_Click" />
                                <CommandBar.SecondaryCommands>
                                    <AppBarButton Label="Cocher les résultats" Icon="SelectAll" Click="SelectAll_Click" />
                                    <AppBarButton Label="Décocher les résultats" Icon="ClearSelection" Click="SelectNone_Click" />
                                    <AppBarButton Label="Envoyer toute la sélection visible" Click="Send_Click" />
                                </CommandBar.SecondaryCommands>
                            </CommandBar>
                            <TextBlock Text="Seuls les messages cochés et visibles seront envoyés." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </PivotItem>
            <PivotItem Header="SMS individuel">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,0,16,16" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" Text="SMS à une seule personne, en dehors des rappels groupés. Le patient est cherché dans la base patients du serveur (nom, prénom ou date de naissance) : ses numéros sont proposés. Vous pouvez y ajouter le lien « Confirmer / Annuler » : la réponse du patient arrive par mail à l’adresse indiquée et s’affiche dans l’historique de tous les postes." />
                        <AutoSuggestBox x:Name="IndividualPatientBox" Header="Patient" PlaceholderText="Nom, prénom ou date de naissance… (facultatif : vous pouvez tout saisir à la main)"
                                        TextChanged="IndividualPatient_TextChanged" SuggestionChosen="IndividualPatient_SuggestionChosen" QueryIcon="Find" />
                        <TextBox x:Name="IndividualNameText" Header="Personne (nom affiché dans l’historique et dans le mail de réponse)" />
                        <ComboBox x:Name="IndividualPhoneText" Header="Téléphone mobile" PlaceholderText="06… ou +33…" IsEditable="True" HorizontalAlignment="Stretch" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <CalendarDatePicker FirstDayOfWeek="Monday" x:Name="IndividualDatePicker" Header="Date du RDV" DateFormat="{}{dayofweek.full} {day.integer} {month.full}" DateChanged="IndividualDate_Changed" />
                            <TimePicker x:Name="IndividualTimePicker" Header="Heure du RDV" ClockIdentifier="24HourClock" MinuteIncrement="5" SelectedTimeChanged="IndividualTime_Changed" />
                        </StackPanel>
                        <CheckBox x:Name="IndividualLinkCheck" Content="Ajouter le lien « Confirmer / Annuler »" Checked="IndividualLink_Changed" Unchecked="IndividualLink_Changed" />
                        <TextBox x:Name="IndividualReplyEmailText" Header="Adresse qui reçoit la réponse du patient" Visibility="Collapsed" InputScope="EmailSmtpAddress" />
                        <TextBox x:Name="IndividualText" Header="Message (rédigé automatiquement d’après la date, l’heure et le lien ; modifiable — [LIEN] est remplacé par le lien à l’envoi)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" TextChanged="IndividualText_Changed" />
                        <TextBlock x:Name="IndividualMetrics" Opacity="0.75" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Texte par défaut" Click="IndividualDefaultText_Click" />
                            <Button Style="{StaticResource AccentButtonStyle}" Content="Envoyer" Click="SendIndividual_Click" />
                        </StackPanel>
                        <TextBlock x:Name="IndividualStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Historique">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="HistoryChannelFilter" Header="Canal" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="HistoryChannel_Changed">
                                <ComboBoxItem Content="Tous les canaux" Tag="" /><ComboBoxItem Content="Mails" Tag="Mail" /><ComboBoxItem Content="SMS" Tag="SMS" />
                            </ComboBox>
                            <TextBox x:Name="HistoryFilter" Grid.Column="1" Header="Rechercher dans les envois" PlaceholderText="Destinataire, date, statut ou réponse (annulé, confirmé, attente)…" TextChanged="HistoryFilter_TextChanged" />
                        </Grid>
                        <CalendarDatePicker FirstDayOfWeek="Monday" x:Name="HistoryDayPicker" Header="Jour d’envoi (heure locale)" PlaceholderText="Tous les jours" DateChanged="HistoryDay_Changed" />
                        <TextBlock x:Name="HistorySummary" Text="Aucun envoi enregistré." TextWrapping="Wrap" FontWeight="SemiBold" />
                        <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                            <AppBarButton Label="Exporter ce jour (Excel)" Icon="Save" Click="ExportHistoryDay_Click" />
                            <AppBarButton Label="Tous les jours" Click="ClearHistoryDay_Click" />
                            <AppBarButton Label="Statuts SMS" Icon="Refresh" Click="History_Click" />
                            <AppBarButton Label="Retours mail" Icon="Mail" Click="MailReports_Click" />
                            <CommandBar.SecondaryCommands>
                                <AppBarButton Label="Importer l’historique EyeEmail" Click="ImportHistory_Click" />
                                <AppBarButton Label="Exporter en CSV" Click="Export_Click" />
                            </CommandBar.SecondaryCommands>
                        </CommandBar>
                    </StackPanel>
                    <ListView x:Name="HistoryList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,4" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding Contact}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <TextBlock Text="{Binding Channel}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CreatedAt}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Reply}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <Button Content="Lire le message envoyé" Click="HistoryMessage_Click" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>
        <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="4">
            <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Visibility="Collapsed" />
            <Button x:Name="StopSendButton" Content="Arrêter l'envoi après le message en cours" Visibility="Collapsed" Click="StopSend_Click"
                    AutomationProperties.Name="Arrêter l'envoi après le message en cours" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>


