<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Client.Pages.SmsMailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Client.SmsMail.Models"
    xmlns:local="using:Client.Pages">
    <Page.Resources>
        <local:MailChannelVisibilityConverter x:Key="MailChannelVisibility" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>
    <Grid Padding="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="SMS et mail" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Préparez vos rappels, vérifiez les destinataires et envoyez en toute simplicité." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Pivot x:Name="Workspace" Grid.Row="1">
            <PivotItem Header="Envois">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <CommandBar Background="Transparent" DefaultLabelPosition="Right" HorizontalContentAlignment="Left">
                        <CommandBar.Content><CalendarDatePicker x:Name="DayPicker" AutomationProperties.Name="Jour des rendez-vous" DateChanged="DayPicker_DateChanged" Margin="0,0,12,0" /></CommandBar.Content>
                        <AppBarButton Label="Charger et préparer" Icon="Download" Click="Load_Click" />
                        <CommandBar.SecondaryCommands>
                            <AppBarButton Label="Préparer à nouveau" Icon="Refresh" Click="Prepare_Click" />
                            <AppBarButton Label="Tester mail / SMS" Click="TestSend_Click" />
                            <AppBarButton Label="Options de préparation" Click="PreparationOptions_Click" />
                            <AppBarButton Label="Heures d’arrivée annoncées" Click="ReminderTimes_Click" />
                            <AppBarButton Label="Voir les horaires ajustés" Click="ReviewTimes_Click" />
                            <AppBarButton Label="Importer des rendez-vous JSON" Click="Import_Click" />
                            <AppBarButton Label="Consulter le solde SMS" Click="Balance_Click" />
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                    <Grid Grid.Row="1" RowSpacing="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ComboBox x:Name="SendChannelFilter" AutomationProperties.Name="Filtrer les envois par canal" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="SendFilter_Changed">
                            <ComboBoxItem Content="Tous les messages" Tag="" /><ComboBoxItem Content="Mails" Tag="Mail" /><ComboBoxItem Content="SMS" Tag="SMS" />
                        </ComboBox>
                        <TextBox x:Name="SendSearch" Grid.Column="1" AutomationProperties.Name="Rechercher un destinataire" PlaceholderText="Rechercher un nom, une adresse mail ou un téléphone…" TextChanged="SendSearch_Changed" />
                        <TextBlock x:Name="SummaryText" Grid.Row="1" Grid.ColumnSpan="2" Text="Choisissez un jour, puis chargez les rendez-vous." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Padding="12,12,28,12" Background="{ThemeResource ControlFillColorSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="86" /><ColumnDefinition Width="60" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="✓" AutomationProperties.Name="Sélection" />
                                <TextBlock Grid.Column="1" Text="Heure RDV ↑" FontWeight="SemiBold" TextWrapping="Wrap" ToolTipService.ToolTip="Tri croissant sur le premier horaire réel du rendez-vous de la famille" />
                                <TextBlock Grid.Column="2" Text="Canal" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Personnes" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="Destinataire" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="Résumé / message" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="6" Text="Statut" FontWeight="SemiBold" />
                            </Grid>
                            <ListView x:Name="MessagesList" Grid.Row="1" AutomationProperties.Name="Tableau des messages à envoyer" SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate><DataTemplate>
                                    <Border Padding="12,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Grid MinHeight="44"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="86" /><ColumnDefinition Width="60" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSend}" AutomationProperties.Name="{Binding Contact}" Checked="MessageSelection_Changed" Unchecked="MessageSelection_Changed" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1" Spacing="4" Margin="0,4,8,0">
                                                <TextBlock Text="{Binding AppointmentTimeDisplay}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ArrivalHint}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Channel}" FontWeight="SemiBold" Margin="0,4,8,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding PeopleDisplay}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,4,12,0" />
                                            <TextBlock Grid.Column="4" Text="{Binding Contact}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,4,12,0" />
                                            <StackPanel Grid.Column="5" Spacing="6" Margin="0,4,16,0">
                                                <TextBlock Text="{Binding TableSummary}" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="21" />
                                                <Button Background="Transparent" BorderThickness="0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Content="Détails du mail" FontSize="12" Padding="0" MinHeight="0" HorizontalAlignment="Left" Visibility="{Binding Channel, Converter={StaticResource MailChannelVisibility}}">
                                                    <Button.Flyout><Flyout Opening="MailDetails_Opening">
                                                        <ScrollViewer MaxHeight="420" MaxWidth="540">
                                                            <StackPanel Spacing="8">
                                                                <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding BodyDisplay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="21" />
                                                            </StackPanel>
                                                        </ScrollViewer>
                                                    </Flyout></Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Grid.Column="6" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate></ListView.ItemTemplate>
                            </ListView>
                            <StackPanel x:Name="EmptyMessagesPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Padding="24" IsHitTestVisible="False">
                                <FontIcon Glyph="&#xE8F2;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="EmptyMessagesText" Text="Vos messages apparaîtront ici" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="Chargez des rendez-vous ou ajustez les filtres." TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="SelectionSummary" Text="Aucun message sélectionné." FontWeight="SemiBold" TextWrapping="Wrap" />
                            <CommandBar Background="Transparent" DefaultLabelPosition="Right" HorizontalContentAlignment="Left">
                                <AppBarButton Label="Envoyer les mails" Icon="Mail" Click="SendMail_Click" />
                                <AppBarButton Label="Envoyer les SMS" Icon="Message" Click="SendSms_Click" />
                                <CommandBar.SecondaryCommands>
                                    <AppBarButton Label="Cocher les résultats" Icon="SelectAll" Click="SelectAll_Click" />
                                    <AppBarButton Label="Décocher les résultats" Icon="ClearSelection" Click="SelectNone_Click" />
                                    <AppBarButton Label="Envoyer toute la sélection visible" Click="Send_Click" />
                                </CommandBar.SecondaryCommands>
                            </CommandBar>
                            <TextBlock Text="Seuls les messages cochés et visibles seront envoyés." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </PivotItem>
            <PivotItem Header="Familles">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                        <AppBarButton Label="Reconstituer les familles" Icon="Refresh" Click="Prepare_Click" />
                        <CommandBar.SecondaryCommands>
                            <AppBarButton Label="Choisir la base familles EyeEmail" Click="FamilyDatabase_Click" />
                            <AppBarButton Label="Comparer l’historique RDV" Click="HistoricalFamilies_Click" />
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                    <TextBlock Grid.Row="1" Text="Vérifiez les personnes et coordonnées avant l'envoi. Les regroupements historiques proposés nécessitent votre validation." TextWrapping="Wrap" />
                    <ListView x:Name="FamiliesList" Grid.Row="2" SelectionMode="None">
                        <ListView.ItemTemplate><DataTemplate>
                            <StackPanel Padding="8" Spacing="6">
                                <TextBlock Text="{Binding Numero}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MembersDisplay}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ContactsDisplay}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding MethodsDisplay}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
            <PivotItem Header="Historique">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="HistoryChannelFilter" Header="Canal" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="HistoryChannel_Changed">
                                <ComboBoxItem Content="Tous les canaux" Tag="" /><ComboBoxItem Content="Mails" Tag="Mail" /><ComboBoxItem Content="SMS" Tag="SMS" />
                            </ComboBox>
                            <TextBox x:Name="HistoryFilter" Grid.Column="1" Header="Rechercher dans les envois" PlaceholderText="Destinataire, date ou statut…" TextChanged="HistoryFilter_TextChanged" />
                        </Grid>
                        <TextBlock x:Name="HistorySummary" Text="Aucun envoi enregistré." TextWrapping="Wrap" FontWeight="SemiBold" />
                        <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                            <AppBarButton Label="Statuts SMS" Icon="Refresh" Click="History_Click" />
                            <AppBarButton Label="Retours mail" Icon="Mail" Click="MailReports_Click" />
                            <CommandBar.SecondaryCommands>
                                <AppBarButton Label="Importer l’historique EyeEmail" Click="ImportHistory_Click" />
                                <AppBarButton Label="Exporter en CSV" Click="Export_Click" />
                            </CommandBar.SecondaryCommands>
                        </CommandBar>
                    </StackPanel>
                    <ListView x:Name="HistoryList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,4" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding Contact}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <TextBlock Text="{Binding Channel}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CreatedAt}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                                        <Button Content="Lire le message envoyé" Click="HistoryMessage_Click" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
            <PivotItem Header="Modèles">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,0,16,16">
                        <TextBlock Text="Variables : [PRENOMS], [CABINET], [ADRESSE_CABINET], [DATE], [DATE_LONGUE], [DatejourL], [DatejourC], [HEURE], [LISTE_PERSONNES]" TextWrapping="Wrap" />
                        <TextBox x:Name="SubjectText" Header="Objet du mail" />
                        <TextBox x:Name="SmsTemplateText" Header="Modèle SMS" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
                        <Expander Header="Code HTML du modèle (avancé)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <TextBox x:Name="EmailTemplateText" TextChanged="EmailHtml_Changed" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200" FontFamily="Consolas" AutomationProperties.Name="Code HTML du mail" />
                        </Expander>
                        <TextBlock Text="Personnaliser le mail" FontSize="18" />
                        <WebView2 x:Name="EmailEditor" Height="440" Loaded="EmailEditor_Loaded" />
                        <TextBlock Text="Les options d’invitation et d’alertes calendrier se règlent dans Paramètres." TextWrapping="Wrap" />
                        <Button Content="Appliquer le modèle de rappel du cabinet" Click="ApplyEmailModel_Click" />
                        <Button Style="{StaticResource AccentButtonStyle}" Content="Enregistrer les modèles" Click="Save_Click" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem x:Name="SettingsTab" Header="Paramètres">
                <ScrollViewer>
                    <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Stretch" Padding="0,0,16,16">
                        <TextBlock Text="Les rendez-vous utilisent la base Access des paramètres RDV et les identifiants Access du poste." TextWrapping="Wrap" />
                    <Expander Header="Votre cabinet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True"><StackPanel Spacing="12">
                        <TextBox x:Name="CabinetText" Header="Nom du cabinet" />
                        <TextBox x:Name="CabinetAddressText" Header="Adresse du cabinet (mail et calendrier)" />
                        <NumberBox x:Name="DurationNumber" Header="Durée de chaque rendez-vous en minutes" Minimum="1" Maximum="480" Value="30" />
                    </StackPanel></Expander>
                    <Expander x:Name="ReminderTimesExpander" Header="Heures d’arrivée annoncées dans les rappels" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Annoncer une arrivée plus tôt dans les SMS, mails et invitations ICS, par exemple 11:20 pour le rendez-vous de 11:30. L’horaire réel du rendez-vous et la base Access restent inchangés." TextWrapping="Wrap" />
                            <CheckBox x:Name="AdjustTimesCheck" Content="Activer les heures d’arrivée personnalisées" Checked="Options_Changed" Unchecked="Options_Changed" />
                            <ListView x:Name="TimeRulesList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate>
                                <StackPanel Spacing="8" Padding="0,8">
                                    <TimePicker Header="Horaire réel du rendez-vous" ClockIdentifier="24HourClock" Time="{Binding From, Mode=TwoWay}" />
                                    <TimePicker Header="Heure d’arrivée annoncée" ClockIdentifier="24HourClock" Time="{Binding To, Mode=TwoWay}" />
                                    <Button Content="Supprimer cette règle" Click="RemoveTimeRule_Click" />
                                </StackPanel>
                            </DataTemplate></ListView.ItemTemplate></ListView>
                            <Button Content="Ajouter un remplacement" Click="AddTimeRule_Click" />
                            <TextBlock Text="Enregistrez les paramètres, puis préparez à nouveau les messages. Un rappel déjà envoyé reste bloqué même si son horaire change." TextWrapping="Wrap" /><TextBlock Text="Dernière préparation : horaires annoncés" FontWeight="SemiBold" />
                            <ScrollViewer MaxHeight="180"><TextBlock x:Name="TimeChangesText" Text="Aucun horaire ajusté." TextWrapping="Wrap" /></ScrollViewer>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="PreparationExpander" Header="Préparation des rappels et familles" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
                        <CheckBox x:Name="UseFamiliesCheck" Content="Regrouper les rendez-vous par famille" Checked="Options_Changed" Unchecked="Options_Changed" />
                        <CheckBox x:Name="SmsOnlyNoEmail" Content="Envoyer un SMS seulement si la famille n’a pas de mail valide" Checked="Options_Changed" Unchecked="Options_Changed" />
                        <TextBlock Text="Un seul SMS par famille et par jour de rendez-vous. Le numéro retenu est visible dans le tableau." TextWrapping="Wrap" />
                        <TextBlock Text="Familles EyeEmail" FontSize="18" FontWeight="SemiBold" />
                        <TextBox x:Name="FamilyDatabaseText" Header="Base familles EyeEmail facultative (.mdb / .accdb)" />
                        <Button Content="Choisir la base familles EyeEmail" Click="FamilyDatabase_Click" />
                    </StackPanel></Expander>
                    <Expander Header="Invitation calendrier et rappels" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
                        <TextBlock Text="Invitation et alertes calendrier" FontSize="18" FontWeight="SemiBold" />
                        <CheckBox x:Name="CalendarInviteCheck" Content="Joindre l'invitation ICS" />
                        <CheckBox x:Name="CalendarAlarmsCheck" Content="Inclure les alertes calendrier" />
                        <CheckBox x:Name="CalendarBusyCheck" Content="Marquer le créneau occupé" />
                        <TextBox x:Name="CalendarSubjectText" Header="Objet de l'événement calendrier" />
                        <ListView x:Name="AlertsList" SelectionMode="None">
                            <ListView.ItemTemplate><DataTemplate>
                                <StackPanel Spacing="4" Padding="0,4">
                                    <TextBox Header="Libellé de l'alerte" Text="{Binding Label, Mode=TwoWay}" />
                                    <NumberBox Header="Minutes avant le rendez-vous (1440 = 1 jour)" Value="{Binding OffsetMinutes, Mode=TwoWay}" Minimum="0" Maximum="525600" />
                                    <TextBlock Text="{Binding OffsetDisplay}" />
                                    <Button Content="Supprimer cette alerte" Click="DeleteAlert_Click" />
                                </StackPanel>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <Button Content="Ajouter une alerte" Click="AddAlert_Click" />
                    </StackPanel></Expander>
                    <Expander Header="Envoi de SMS · OVH" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
                        <TextBlock Text="Compte SMS OVH" FontSize="18" FontWeight="SemiBold" />
                        <TextBox x:Name="SmsAccountText" Header="Nom du service SMS" />
                        <TextBox x:Name="SmsSenderText" Header="Expéditeur SMS autorisé par OVH" />
                        <TextBox x:Name="SmsAppKeyText" Header="Application key" />
                        <PasswordBox x:Name="SmsSecretText" Header="Application secret" />
                        <PasswordBox x:Name="SmsConsumerText" Header="Consumer key" />
                    </StackPanel></Expander>
                    <Expander Header="Envoi de mails · SMTP" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
                        <TextBlock Text="Compte mail SMTP" FontSize="18" FontWeight="SemiBold" />
                        <TextBox x:Name="SmtpHostText" Header="Serveur SMTP" />
                        <NumberBox x:Name="SmtpPortNumber" Header="Port SMTP (STARTTLS : 587)" Minimum="1" Maximum="65535" Value="587" />
                        <CheckBox x:Name="SmtpSslCheck" Content="Connexion sécurisée STARTTLS" IsChecked="True" />
                        <TextBox x:Name="MailUserText" Header="Identifiant SMTP" />
                        <PasswordBox x:Name="MailPasswordText" Header="Mot de passe SMTP" />
                        <TextBox x:Name="MailFromText" Header="Adresse d'envoi et de retour des notifications" />
                        <TextBox x:Name="MailDisplayText" Header="Nom de l'expéditeur" />
                    </StackPanel></Expander>
                    <Expander Header="Suivi des mails · IMAP" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
                        <TextBlock Text="Notifications mail IMAP (facultatif, mêmes identifiants que SMTP)" TextWrapping="Wrap" />
                        <TextBox x:Name="ImapHostText" Header="Serveur IMAP" />
                        <NumberBox x:Name="ImapPortNumber" Header="Port IMAP TLS" Value="993" Minimum="1" Maximum="65535" />
                        <TextBox x:Name="BounceFilterText" Header="Expéditeur des retours (ex. mailer-daemon)" />
                    </StackPanel></Expander>
                        <Button Style="{StaticResource AccentButtonStyle}" Content="Enregistrer les paramètres" Click="Save_Click" />
                        <Button Content="Tester mail / SMS" Click="TestSend_Click" />
                        <TextBlock Text="Paramètres et identifiants sont chiffrés pour votre compte Windows. L'historique reste sur ce poste." TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="RDV importés">
                <ListView x:Name="AppointmentsList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding DateRDV}" /><TextBlock Text="{Binding HeureRDV}" />
                                    <TextBlock Text="{Binding Nom}" /><TextBlock Text="{Binding Prenom}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Tel1}" /><TextBlock Text="{Binding Tel2}" /><TextBlock Text="{Binding Email}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Remarque}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>
        <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="4">
            <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>

