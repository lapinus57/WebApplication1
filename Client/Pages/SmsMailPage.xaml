<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Client.Pages.SmsMailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Client.SmsMail.Models">
    <Grid Padding="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="SMS et mail" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />
        <Pivot x:Name="Workspace" Grid.Row="1">
            <PivotItem Header="Rendez-vous et envoi">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CalendarDatePicker x:Name="DayPicker" Header="Jour des rendez-vous" DateChanged="DayPicker_DateChanged" />
                            <Button Content="Charger les rendez-vous" Click="Load_Click" VerticalAlignment="Bottom" />
                            <Button Content="Importer JSON" Click="Import_Click" VerticalAlignment="Bottom" />
                            <Button Content="Solde SMS" Click="Balance_Click" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <CheckBox x:Name="SmsOnlyNoEmail" Content="Envoyer un SMS uniquement en l'absence d'adresse mail valide"
                                  Checked="Options_Changed" Unchecked="Options_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="SummaryText" Text="Chargez les rendez-vous pour préparer les messages." VerticalAlignment="Center" />
                        <Button Content="Préparer les messages" Click="Prepare_Click" />
                        <Button Content="Envoyer la sélection" Click="Send_Click" />
                    </StackPanel>
                    <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListView x:Name="MessagesList" SelectionChanged="MessagesList_SelectionChanged" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4" Padding="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Content="{Binding Channel}" />
                                            <TextBlock Text="{Binding Contact}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Family}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Metrics}" />
                                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid Grid.Column="1" RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="Message préparé (SMS ou contenu HTML du mail)" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBox x:Name="MessagePreview" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Grid>
                </Grid>
            </PivotItem>
            <PivotItem Header="Historique">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="HistoryFilter" PlaceholderText="Filtrer par contact ou statut" Width="250" TextChanged="HistoryFilter_TextChanged" />
                        <Button Content="Actualiser les statuts SMS" Click="History_Click" />
                        <Button Content="Exporter CSV" Click="Export_Click" />
                    </StackPanel>
                    <ListView x:Name="HistoryList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding Channel}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Contact}" />
                                        <TextBlock Text="{Binding CreatedAt}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" MaxHeight="100" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
            <PivotItem Header="Modèles">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,0,16,16">
                        <TextBlock Text="Variables : [PRENOMS], [CABINET], [ADRESSE_CABINET], [DATE], [DATE_LONGUE], [HEURE], [LISTE_PERSONNES]" TextWrapping="Wrap" />
                        <TextBox x:Name="SubjectText" Header="Objet du mail" />
                        <TextBox x:Name="SmsTemplateText" Header="Modèle SMS" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
                        <TextBox x:Name="EmailTemplateText" Header="Modèle e-mail HTML" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="240" />
                        <TextBlock Text="Chaque mail contient une invitation calendrier (.ics), en heure de Paris." TextWrapping="Wrap" />
                        <Button Content="Appliquer le modèle de rappel du cabinet" Click="ApplyEmailModel_Click" />
                        <Button Content="Enregistrer les modèles" Click="Save_Click" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Paramètres">
                <ScrollViewer>
                    <StackPanel Spacing="12" MaxWidth="700" HorizontalAlignment="Left" Padding="0,0,16,16">
                        <TextBlock Text="Les rendez-vous utilisent la base Access des paramètres RDV et les identifiants Access du poste." TextWrapping="Wrap" />
                        <TextBox x:Name="CabinetText" Header="Nom du cabinet" Width="550" />
                        <TextBox x:Name="CabinetAddressText" Header="Adresse du cabinet (mail et calendrier)" />
                        <NumberBox x:Name="DurationNumber" Header="Durée de chaque rendez-vous en minutes" Minimum="1" Maximum="480" Value="30" />
                        <TextBlock Text="Compte SMS OVH" FontSize="18" FontWeight="SemiBold" />
                        <TextBox x:Name="SmsAccountText" Header="Nom du service SMS" />
                        <TextBox x:Name="SmsSenderText" Header="Expéditeur SMS autorisé par OVH" />
                        <TextBox x:Name="SmsAppKeyText" Header="Application key" />
                        <PasswordBox x:Name="SmsSecretText" Header="Application secret" />
                        <PasswordBox x:Name="SmsConsumerText" Header="Consumer key" />
                        <TextBlock Text="Compte mail SMTP" FontSize="18" FontWeight="SemiBold" />
                        <TextBox x:Name="SmtpHostText" Header="Serveur SMTP" />
                        <NumberBox x:Name="SmtpPortNumber" Header="Port SMTP (STARTTLS : 587)" Minimum="1" Maximum="65535" Value="587" />
                        <CheckBox x:Name="SmtpSslCheck" Content="Connexion sécurisée STARTTLS" IsChecked="True" />
                        <TextBox x:Name="MailUserText" Header="Identifiant SMTP" />
                        <PasswordBox x:Name="MailPasswordText" Header="Mot de passe SMTP" />
                        <TextBox x:Name="MailFromText" Header="Adresse d'envoi et de retour des notifications" />
                        <TextBox x:Name="MailDisplayText" Header="Nom de l'expéditeur" />
                        <Button Content="Enregistrer les paramètres" Click="Save_Click" />
                        <TextBlock Text="Paramètres et identifiants sont chiffrés pour votre compte Windows. L'historique reste sur ce poste." TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="RDV importés">
                <ListView x:Name="AppointmentsList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding DateRDV}" /><TextBlock Text="{Binding HeureRDV}" />
                                    <TextBlock Text="{Binding Nom}" /><TextBlock Text="{Binding Prenom}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Tel1}" /><TextBlock Text="{Binding Tel2}" /><TextBlock Text="{Binding Email}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Remarque}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>
        <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="4">
            <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
