<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Client.Pages.SmsMailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Client.SmsMail.Models">
    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>
    <Grid Padding="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="SMS et mail" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Préparez vos rappels, vérifiez les destinataires et envoyez en toute simplicité." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Pivot x:Name="Workspace" Grid.Row="1">
            <PivotItem Header="Envois">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="1. Choisir les rendez-vous" FontWeight="SemiBold" FontSize="18" />
                            <CommandBar Background="Transparent" DefaultLabelPosition="Right" HorizontalContentAlignment="Left">
                                <CommandBar.Content><CalendarDatePicker x:Name="DayPicker" AutomationProperties.Name="Jour des rendez-vous" DateChanged="DayPicker_DateChanged" Margin="0,0,12,0" /></CommandBar.Content>
                                <AppBarButton Label="Charger" Icon="Download" Click="Load_Click" />
                                <AppBarButton Label="Tester mail / SMS" Icon="Send" Click="TestSend_Click" />
                                <CommandBar.SecondaryCommands>
                                    <AppBarButton Label="Importer des rendez-vous JSON" Click="Import_Click" />
                                    <AppBarButton Label="Consulter le solde SMS" Click="Balance_Click" />
                                </CommandBar.SecondaryCommands>
                            </CommandBar>
                            <Expander Header="Options de préparation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="4">
                                    <CheckBox x:Name="UseFamiliesCheck" Content="Regrouper les rendez-vous par famille" Checked="Options_Changed" Unchecked="Options_Changed" />
                                    <CheckBox x:Name="SmsOnlyNoEmail" Content="Envoyer un SMS seulement si la famille n’a pas de mail valide" Checked="Options_Changed" Unchecked="Options_Changed" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="1" Spacing="8">
                        <TextBlock Text="2. Vérifier et envoyer" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="SummaryText" Text="Commencez par charger les rendez-vous du jour choisi." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CommandBar Background="Transparent" DefaultLabelPosition="Right" HorizontalContentAlignment="Left">
                            <AppBarButton Label="Préparer" Icon="Refresh" Click="Prepare_Click" />
                            <AppBarButton Label="Tout cocher" Icon="SelectAll" Click="SelectAll_Click" />
                            <AppBarButton Label="Tout décocher" Icon="ClearSelection" Click="SelectNone_Click" />
                            <AppBarButton Label="Envoyer la sélection" Icon="Send" Click="Send_Click" />
                        </CommandBar>
                    </StackPanel>
                    <Grid Grid.Row="2" ColumnSpacing="16" RowSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <VisualStateManager.VisualStateGroups><VisualStateGroup>
                            <VisualState x:Name="Narrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers><VisualState.Setters>
                                <Setter Target="PreviewCard.(Grid.Row)" Value="1" />
                                <Setter Target="PreviewCard.(Grid.Column)" Value="0" />
                                <Setter Target="PreviewCard.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="MessagesList.(Grid.ColumnSpan)" Value="2" />
                            </VisualState.Setters></VisualState>
                            <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers><VisualState.Setters>
                                <Setter Target="PreviewCard.(Grid.RowSpan)" Value="2" />
                                <Setter Target="MessagesList.(Grid.RowSpan)" Value="2" />
                            </VisualState.Setters></VisualState>
                        </VisualStateGroup></VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListView Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" AutomationProperties.Name="Messages à envoyer" x:Name="MessagesList" SelectionChanged="MessagesList_SelectionChanged" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="6" Padding="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Content="{Binding Channel}" />
                                            <TextBlock Text="{Binding Contact}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Family}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Metrics}" />
                                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Border x:Name="PreviewCard" Grid.Column="1" Style="{StaticResource Card}">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="Aperçu du message" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="PreviewCaption" Grid.Row="1" Text="Sélectionnez un message pour le consulter ici." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="MessagePreview" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="Contenu du message" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                <WebView2 x:Name="MailPreview" Grid.Row="2" Visibility="Collapsed" Loaded="MailPreview_Loaded" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </PivotItem>
            <PivotItem Header="Familles">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                        <AppBarButton Label="Reconstituer les familles" Icon="Refresh" Click="Prepare_Click" />
                        <CommandBar.SecondaryCommands>
                            <AppBarButton Label="Choisir la base familles EyeEmail" Click="FamilyDatabase_Click" />
                            <AppBarButton Label="Comparer l’historique RDV" Click="HistoricalFamilies_Click" />
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                    <TextBlock Grid.Row="1" Text="Vérifiez les personnes et coordonnées avant l'envoi. Les regroupements historiques proposés nécessitent votre validation." TextWrapping="Wrap" />
                    <ListView x:Name="FamiliesList" Grid.Row="2" SelectionMode="None">
                        <ListView.ItemTemplate><DataTemplate>
                            <StackPanel Padding="8" Spacing="6">
                                <TextBlock Text="{Binding Numero}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MembersDisplay}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ContactsDisplay}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding MethodsDisplay}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
            <PivotItem Header="Historique">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <TextBox x:Name="HistoryFilter" PlaceholderText="Rechercher un destinataire ou un statut…" AutomationProperties.Name="Rechercher dans l’historique" TextChanged="HistoryFilter_TextChanged" />
                        <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                            <AppBarButton Label="Statuts SMS" Icon="Refresh" Click="History_Click" />
                            <AppBarButton Label="Retours mail" Icon="Mail" Click="MailReports_Click" />
                            <CommandBar.SecondaryCommands>
                                <AppBarButton Label="Importer l’historique EyeEmail" Click="ImportHistory_Click" />
                                <AppBarButton Label="Exporter en CSV" Click="Export_Click" />
                            </CommandBar.SecondaryCommands>
                        </CommandBar>
                    </StackPanel>
                    <ListView x:Name="HistoryList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding Channel}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Contact}" />
                                        <TextBlock Text="{Binding CreatedAt}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" MaxHeight="100" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
            <PivotItem Header="Modèles">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,0,16,16">
                        <TextBlock Text="Variables : [PRENOMS], [CABINET], [ADRESSE_CABINET], [DATE], [DATE_LONGUE], [DatejourL], [DatejourC], [HEURE], [LISTE_PERSONNES]" TextWrapping="Wrap" />
                        <TextBox x:Name="SubjectText" Header="Objet du mail" />
                        <TextBox x:Name="SmsTemplateText" Header="Modèle SMS" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
                        <Expander Header="Code HTML du modèle (avancé)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <TextBox x:Name="EmailTemplateText" TextChanged="EmailHtml_Changed" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200" FontFamily="Consolas" AutomationProperties.Name="Code HTML du mail" />
                        </Expander>
                        <TextBlock Text="Personnaliser le mail" FontSize="18" />
                        <WebView2 x:Name="EmailEditor" Height="440" Loaded="EmailEditor_Loaded" />
                        <TextBlock Text="Les options d’invitation et d’alertes calendrier se règlent dans Paramètres." TextWrapping="Wrap" />
                        <Button Content="Appliquer le modèle de rappel du cabinet" Click="ApplyEmailModel_Click" />
                        <Button Style="{StaticResource AccentButtonStyle}" Content="Enregistrer les modèles" Click="Save_Click" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Paramètres">
                <ScrollViewer>
                    <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Stretch" Padding="0,0,16,16">
                        <TextBlock Text="Les rendez-vous utilisent la base Access des paramètres RDV et les identifiants Access du poste." TextWrapping="Wrap" />
                    <Expander Header="Votre cabinet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True"><StackPanel Spacing="12">
                        <TextBox x:Name="CabinetText" Header="Nom du cabinet" />
                        <TextBox x:Name="CabinetAddressText" Header="Adresse du cabinet (mail et calendrier)" />
                        <NumberBox x:Name="DurationNumber" Header="Durée de chaque rendez-vous en minutes" Minimum="1" Maximum="480" Value="30" />
                    </StackPanel></Expander>
                    <Expander Header="Regroupement des familles" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
                        <TextBlock Text="Familles EyeEmail" FontSize="18" FontWeight="SemiBold" />
                        <TextBox x:Name="FamilyDatabaseText" Header="Base familles EyeEmail facultative (.mdb / .accdb)" />
                        <Button Content="Choisir la base familles EyeEmail" Click="FamilyDatabase_Click" />
                    </StackPanel></Expander>
                    <Expander Header="Invitation calendrier et rappels" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
                        <TextBlock Text="Invitation et alertes calendrier" FontSize="18" FontWeight="SemiBold" />
                        <CheckBox x:Name="CalendarInviteCheck" Content="Joindre l'invitation ICS" />
                        <CheckBox x:Name="CalendarAlarmsCheck" Content="Inclure les alertes calendrier" />
                        <CheckBox x:Name="CalendarBusyCheck" Content="Marquer le créneau occupé" />
                        <TextBox x:Name="CalendarSubjectText" Header="Objet de l'événement calendrier" />
                        <ListView x:Name="AlertsList" SelectionMode="None">
                            <ListView.ItemTemplate><DataTemplate>
                                <StackPanel Spacing="4" Padding="0,4">
                                    <TextBox Header="Libellé de l'alerte" Text="{Binding Label, Mode=TwoWay}" />
                                    <NumberBox Header="Minutes avant le rendez-vous (1440 = 1 jour)" Value="{Binding OffsetMinutes, Mode=TwoWay}" Minimum="0" Maximum="525600" />
                                    <TextBlock Text="{Binding OffsetDisplay}" />
                                    <Button Content="Supprimer cette alerte" Click="DeleteAlert_Click" />
                                </StackPanel>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <Button Content="Ajouter une alerte" Click="AddAlert_Click" />
                    </StackPanel></Expander>
                    <Expander Header="Envoi de SMS · OVH" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
                        <TextBlock Text="Compte SMS OVH" FontSize="18" FontWeight="SemiBold" />
                        <TextBox x:Name="SmsAccountText" Header="Nom du service SMS" />
                        <TextBox x:Name="SmsSenderText" Header="Expéditeur SMS autorisé par OVH" />
                        <TextBox x:Name="SmsAppKeyText" Header="Application key" />
                        <PasswordBox x:Name="SmsSecretText" Header="Application secret" />
                        <PasswordBox x:Name="SmsConsumerText" Header="Consumer key" />
                    </StackPanel></Expander>
                    <Expander Header="Envoi de mails · SMTP" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
                        <TextBlock Text="Compte mail SMTP" FontSize="18" FontWeight="SemiBold" />
                        <TextBox x:Name="SmtpHostText" Header="Serveur SMTP" />
                        <NumberBox x:Name="SmtpPortNumber" Header="Port SMTP (STARTTLS : 587)" Minimum="1" Maximum="65535" Value="587" />
                        <CheckBox x:Name="SmtpSslCheck" Content="Connexion sécurisée STARTTLS" IsChecked="True" />
                        <TextBox x:Name="MailUserText" Header="Identifiant SMTP" />
                        <PasswordBox x:Name="MailPasswordText" Header="Mot de passe SMTP" />
                        <TextBox x:Name="MailFromText" Header="Adresse d'envoi et de retour des notifications" />
                        <TextBox x:Name="MailDisplayText" Header="Nom de l'expéditeur" />
                    </StackPanel></Expander>
                    <Expander Header="Suivi des mails · IMAP" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
                        <TextBlock Text="Notifications mail IMAP (facultatif, mêmes identifiants que SMTP)" TextWrapping="Wrap" />
                        <TextBox x:Name="ImapHostText" Header="Serveur IMAP" />
                        <NumberBox x:Name="ImapPortNumber" Header="Port IMAP TLS" Value="993" Minimum="1" Maximum="65535" />
                        <TextBox x:Name="BounceFilterText" Header="Expéditeur des retours (ex. mailer-daemon)" />
                    </StackPanel></Expander>
                        <Button Style="{StaticResource AccentButtonStyle}" Content="Enregistrer les paramètres" Click="Save_Click" />
                        <Button Content="Tester mail / SMS" Click="TestSend_Click" />
                        <TextBlock Text="Paramètres et identifiants sont chiffrés pour votre compte Windows. L'historique reste sur ce poste." TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="RDV importés">
                <ListView x:Name="AppointmentsList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding DateRDV}" /><TextBlock Text="{Binding HeureRDV}" />
                                    <TextBlock Text="{Binding Nom}" /><TextBlock Text="{Binding Prenom}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Tel1}" /><TextBlock Text="{Binding Tel2}" /><TextBlock Text="{Binding Email}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Remarque}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>
        <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="4">
            <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>

