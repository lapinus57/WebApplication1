@page
@model Serveur.Pages.FundusModel
@using EyeChat.Fundus
@using System.Globalization
@{
    ViewData["Title"] = "Préparation FO";
    ViewData["HideChrome"] = true;
    var from = (Model.From ?? Model.Today).ToString("yyyy-MM-dd");
    var to = (Model.To ?? Model.Today.AddDays(6)).ToString("yyyy-MM-dd");
    var fr = CultureInfo.GetCultureInfo("fr-FR");
}
<link rel="stylesheet" href="~/css/fundus.css" asp-append-version="true" />
<div class="fo-page">
    <header class="fo-heading">
        <div>
            <span class="fo-eyebrow">PRÉPARATION FO</span>
            <h1>Patients à préparer pour un fond d’œil</h1>
            <p>Consignes retrouvées dans Observation et REFRACTION de la table Consultation (Access).</p>
        </div>
        <div class="fo-account">
            <span>@User.Identity?.Name</span>
            <form method="post" asp-page="/Logout"><button type="submit">Déconnexion</button></form>
        </div>
    </header>
    <p class="fo-help">La liste inclut les FO à prévoir et les cas à vérifier dans le dossier. Elle aide à préparer la consultation ; elle ne décide pas de l’examen à réaliser.</p>
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="fo-error" role="alert">
            <strong>La recherche n’a pas abouti.</strong> @Model.Error
            @if (Model.Configured) { <p>Les éventuelles lignes ci-dessous sont des résultats précédents, à actualiser avant utilisation.</p> }
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.Notice)) { <div class="fo-notice" role="status">@Model.Notice</div> }
    <nav class="fo-shortcuts" aria-label="Périodes de rendez-vous">
        <a asp-page="/Fundus" asp-route-from="@Model.Today.ToString("yyyy-MM-dd")" asp-route-to="@Model.Today.ToString("yyyy-MM-dd")" asp-route-status="@Model.Status">Aujourd’hui</a>
        <a asp-page="/Fundus" asp-route-from="@Model.Today.AddDays(1).ToString("yyyy-MM-dd")" asp-route-to="@Model.Today.AddDays(1).ToString("yyyy-MM-dd")" asp-route-status="@Model.Status">Demain</a>
        <a asp-page="/Fundus" asp-route-from="@Model.Today.ToString("yyyy-MM-dd")" asp-route-to="@Model.Today.AddDays(6).ToString("yyyy-MM-dd")" asp-route-status="@Model.Status">Les 7 prochains jours</a>
        <a class="fo-settings-link" asp-page="/Fundus" asp-route-configure="true" asp-route-from="@from" asp-route-to="@to">Réglages Access</a>
    </nav>
    <form method="get" class="fo-filters">
        <label>Rendez-vous du<input type="date" name="From" value="@from" min="@Model.Today.ToString("yyyy-MM-dd")" required /></label>
        <label>Au<input type="date" name="To" value="@to" min="@Model.Today.ToString("yyyy-MM-dd")" required /></label>
        <label>Patients à afficher
            <select asp-for="Status">
                <option value="">À préparer : FO à prévoir + à vérifier</option>
                <option value="Planned">FO à prévoir</option>
                <option value="Verify">À vérifier</option>
                <option value="ProbablyPerformed">FO probablement réalisé</option>
            </select>
        </label>
        <button type="submit">Voir les patients</button>
    </form>
    @if (Model.ShowMapping)
    {
        <section class="fo-config">
            <h2>Correspondance avec votre base Access</h2>
            <p>Les choix ci-dessous proviennent du schéma lu sur le serveur. Access reste en lecture seule. Le même identifiant patient doit relier les trois tables.</p>
            <form method="post" asp-page-handler="Mapping" id="fo-mapping">
                <input type="hidden" name="From" value="@from" /><input type="hidden" name="To" value="@to" /><input type="hidden" name="Status" value="@Model.Status" />
                @foreach (var group in new[] { "Patients", "Consultations", "Appointments" })
                {
                    var tableProperty = group + "Table";
                    var selectedTable = (string)typeof(FoMapping).GetProperty(tableProperty)!.GetValue(Model.Mapping)!;
                    var columnProperties = group switch {
                        "Patients" => new[] { ("PatientId", "Identifiant patient"), ("LastName", "Nom"), ("FirstName", "Prénom") },
                        "Consultations" => new[] { ("ConsultationId", "Identifiant consultation"), ("ConsultationPatientId", "Identifiant patient de la consultation"), ("ConsultationDate", "Date de la consultation") },
                        _ => new[] { ("AppointmentPatientId", "Identifiant patient du rendez-vous"), ("AppointmentDate", "Date du rendez-vous"), ("AppointmentTime", "Heure du rendez-vous"), ("Cancelled", "Annulation (optionnel si absence confirmée)") }
                    };
                    <fieldset class="fo-map-group"><legend>@(group == "Patients" ? "Patients" : group == "Consultations" ? "Consultations" : "Agenda")</legend>
                        <label>Table<select name="Mapping.@tableProperty" class="fo-table" required><option value="">Choisir une table</option>@foreach (var table in Model.Fields.Select(f => f.Table).Distinct()) { <option value="@table" selected="@(table == selectedTable)">@table</option> }</select></label>
                        @foreach (var (property, label) in columnProperties)
                        {
                            var value = (string)typeof(FoMapping).GetProperty(property)!.GetValue(Model.Mapping)!;
                            <label>@label<select name="Mapping.@property" class="fo-column" required="@(property != "Cancelled")"><option value="">Choisir un champ</option>@foreach (var field in Model.Fields) { <option value="@field.Name" data-table="@field.Table" selected="@(field.Table == selectedTable && field.Name == value)">@field.Name</option> }</select></label>
                        }
                        @if (group == "Consultations")
                        {
                            <p class="fo-help">Textes analysés : <strong>Observation</strong> et <strong>REFRACTION</strong>. Leur présence sera vérifiée dans cette table.</p>
                        }
                        @if (group == "Appointments") { <label class="fo-checkbox"><input asp-for="Mapping.NoCancellationColumn" />J’ai vérifié : cette table ne possède pas de champ d’annulation.</label> }
                    </fieldset>
                }
                <p class="fo-help">Les comptes rendus doivent être en texte simple. Un champ RTF/HTML ou un identifiant manquant interrompt l’analyse avec une indication, sans enregistrer de liste partielle.</p>
                <button type="submit" class="fo-primary">Enregistrer et rechercher les patients</button>
            </form>
        </section>
    }
    @if (Model.Configured)
    {
        <section aria-label="Patients repérés" class="fo-counts">
            <div><strong>@Model.PlannedCount</strong><span>FO à prévoir</span></div>
            <div><strong>@Model.VerifyCount</strong><span>À vérifier</span></div>
            <div class="fo-count-secondary"><strong>@Model.CompletedCount</strong><span>Probablement réalisés</span></div>
        </section>
        <div class="fo-results-heading">
            <div>
                <h2>Liste des patients</h2>
                <p id="fo-list-count" aria-live="polite">@Model.Alerts.Count patient(s) affiché(s) · du @(Model.From?.ToString("dd/MM/yyyy")) au @(Model.To?.ToString("dd/MM/yyyy"))</p>
                @if (Model.SearchTime.HasValue) { <small>Recherche effectuée à @Model.SearchTime.Value.ToString("HH:mm") · horaires du cabinet</small> }
            </div>
            <form method="post" asp-page-handler="Refresh" class="fo-refresh" id="fo-search" data-auto-search="@(Model.AutoSearch ? "true" : "false")">
                <input type="hidden" name="From" value="@from" />
                <input type="hidden" name="To" value="@to" />
                <input type="hidden" name="Status" value="@Model.Status" />
                <button type="submit" class="fo-primary">Rechercher les patients dans Access</button>
            </form>
        </div>
        <div class="fo-search-progress" id="fo-search-progress" role="status" hidden>
            <span class="fo-spinner" aria-hidden="true"></span> Lecture des consultations Access et recherche des patients en cours…
        </div>
        <noscript><p>Cliquez sur « Rechercher les patients dans Access » pour charger la liste actuelle.</p></noscript>
        @if (Model.Alerts.Count == 0)
        {
            <div class="fo-empty" id="fo-empty">
                @if (Model.AutoSearch) { <strong>La recherche des patients va démarrer…</strong> }
                else if (!string.IsNullOrEmpty(Model.Error)) { <span>Impossible de confirmer la liste actuelle. Corrigez le problème indiqué puis relancez la recherche.</span> }
                else if (Model.SearchCompleted && Model.PatientsAnalyzed == 0) { <span>Aucun patient avec un rendez-vous futur dans cette période. Essayez une période plus large.</span> }
                else if (Model.SearchCompleted && Model.Total == 0) { <span>Aucune consigne de FO retenue dans les consultations des @Model.PatientsAnalyzed patient(s) analysé(s). Vous pouvez élargir la période.</span> }
                else if (Model.Total > 0) { <span>Aucun patient dans l’état choisi. Changez le filtre « Patients à afficher ».</span> }
                else { <span>Aucun patient dans les résultats précédents. Relancez la recherche pour consulter la base Access à jour.</span> }
            </div>
        }
        else
        {
            <label class="fo-patient-search">Retrouver un patient dans cette liste
                <input type="search" id="fo-patient-search" placeholder="Nom, prénom ou identifiant" autocomplete="off" />
            </label>
            <div class="fo-table-wrap" id="fo-patient-list">
                <table class="fo-results">
                    <thead><tr><th scope="col">Patient</th><th scope="col">Prochain RDV ↑</th><th scope="col">Pourquoi ce patient apparaît</th><th scope="col">État</th></tr></thead>
                    <tbody>
                    @foreach (var alert in Model.Alerts)
                    {
                        <tr class="fo-patient-row">
                            <td class="fo-patient-identity"><strong>@alert.PatientName</strong><small>Identifiant @alert.PatientId</small></td>
                            <td class="fo-appointment"><strong>@alert.NextAppointment?.ToString("HH:mm")</strong><span>@alert.NextAppointment?.ToString("ddd dd MMM yyyy", fr)</span></td>
                            <td>
                                <small>Consigne du @alert.SourceDate.ToString("dd/MM/yyyy")</small>
                                <blockquote>@alert.Excerpt</blockquote>
                                <a asp-route-from="@from" asp-route-to="@to" asp-route-status="@Model.Status" asp-route-source="@alert.Id">Lire la consultation source</a>
                                @if (!string.IsNullOrEmpty(alert.LaterExcerpt))
                                {
                                    <details><summary>Élément ultérieur du @alert.LaterDate?.ToString("dd/MM/yyyy")</summary><blockquote>@alert.LaterExcerpt</blockquote></details>
                                }
                            </td>
                            <td>
                                <span class="fo-badge fo-@alert.EffectiveStatus">@FundusAnalysis.Label(alert.EffectiveStatus)</span>
                                <p>@alert.Reason</p>
                                <details>
                                    <summary>Suivi et validation</summary>
                                    <small>Analysé le @alert.LastAnalysisUtc.ToString("dd/MM/yyyy HH:mm") UTC</small>
                                    @if (alert.ManualStatus.HasValue) { <small>Validation manuelle · @alert.ReviewedBy · @alert.ReviewedUtc?.ToString("dd/MM/yyyy HH:mm") UTC</small> }
                                    <form method="post" asp-page-handler="Review" class="fo-review">
                                        <input type="hidden" name="id" value="@alert.Id" />
                                        <input type="hidden" name="evidenceHash" value="@alert.EvidenceHash" />
                                        <input type="hidden" name="From" value="@from" />
                                        <input type="hidden" name="To" value="@to" />
                                        <input type="hidden" name="Status" value="@Model.Status" />
                                        <label>Après relecture du dossier
                                            <select name="review"><option value="">Analyse automatique</option>@foreach (var state in Enum.GetValues<FoStatus>()) { <option value="@state" selected="@(alert.ManualStatus == state)">@FundusAnalysis.Label(state)</option> }</select>
                                        </label>
                                        <button type="submit">Enregistrer</button>
                                    </form>
                                </details>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p id="fo-no-match" class="fo-empty" hidden>Aucun patient ne correspond au nom ou à l’identifiant saisi.</p>
        }
    }
    @if (Model.Consultation != null)
    {
        <section class="fo-source" id="consultation-source" tabindex="-1">
            <h2>Consultation source du @Model.Consultation.Date.ToString("dd/MM/yyyy")</h2>
            <p>Texte relu directement dans Access. Il peut avoir changé depuis la dernière analyse.</p>
            <h3>Observation</h3><pre>@Model.Consultation.Text</pre>
            @if (!string.IsNullOrEmpty(Model.Consultation.RefractionText)) { <h3>REFRACTION</h3><pre>@Model.Consultation.RefractionText</pre> }
            <a asp-route-from="@from" asp-route-to="@to" asp-route-status="@Model.Status">Fermer la consultation</a>
        </section>
    }
</div>
<script src="~/js/fundus.js" asp-append-version="true"></script>
