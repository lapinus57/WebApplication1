<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#10233f" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href="~/mobile.webmanifest" />
    <title>@ViewData["Title"] - EyeChat</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (!(ViewData["HideChrome"] as bool? ?? false))
    {
        var currentPage = ViewContext.RouteData.Values["page"] as string ?? "";
        string Active(string page) => string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase) ? "is-active" : "";
    <header class="topbar">
        <div class="shell topbar-content">
            <a class="brand" asp-page="/Index" aria-label="EyeChat - État du serveur">
                <span class="brand-mark" aria-hidden="true">E</span>
                <span><strong>EyeChat</strong><small>Administration serveur</small></span>
            </a>
            <div class="topbar-actions">
                <div class="topbar-state"><span></span><em>Service démarré</em></div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="admin-name">@User.Identity.Name</span>
                    <form method="post" asp-page="/Logout"><button class="logout-button" type="submit">Déconnexion</button></form>
                }
            </div>
        </div>
    </header>
    @if (User.Identity?.IsAuthenticated == true)
    {
    <nav class="admin-nav" aria-label="Administration">
        <div class="shell admin-nav-links">
            <a class="@Active("/Index")" asp-page="/Index">Accueil</a>
            <span class="admin-nav-group">Patients</span>
            <a class="@Active("/Fundus")" asp-page="/Fundus">Préparation FO</a>
            <a class="@Active("/PatientRegistry")" asp-page="/PatientRegistry">Diabète / HTO</a>
            <a class="@Active("/EyeMail")" asp-page="/EyeMail">Base patients</a>
            <a class="@Active("/Families")" asp-page="/Families">Familles</a>
            <span class="admin-nav-group">Rappels</span>
            <a class="@Active("/SmsMail")" asp-page="/SmsMail">SMS et mail</a>
            <a class="@Active("/Replies")" asp-page="/Replies">Réponses</a>
            <span class="admin-nav-group">Système</span>
            <a class="@Active("/Clients")" asp-page="/Clients">Postes</a>
            <a class="@Active("/AccessSettings")" asp-page="/AccessSettings">Réglages Access</a>
        </div>
    </nav>
    }
    }

    <main class="@((ViewData["HideChrome"] as bool? ?? false) ? "" : "shell")" role="main">
        @RenderBody()
    </main>

    @if (!(ViewData["HideChrome"] as bool? ?? false))
    {
    <footer class="shell footer">
        <span>EyeChat Server</span>
        <span>Interface disponible sur le réseau local</span>
    </footer>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
