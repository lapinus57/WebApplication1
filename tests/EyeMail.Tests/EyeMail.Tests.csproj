<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Serveur/EyeMail/*.cs" Exclude="../../Serveur/EyeMail/EyeMailAccessSource.cs" LinkBase="EyeMail" />
    <Compile Include="../../Shared/Fundus/*.cs" LinkBase="Fundus" />
    <Compile Include="../../Shared/ReadOnlyAccess.cs" Link="Fundus/ReadOnlyAccess.cs" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="System.Data.OleDb" Version="8.0.0" />
    <PackageReference Include="RtfPipe" Version="2.0.7677.4303" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
  </ItemGroup>
</Project>
