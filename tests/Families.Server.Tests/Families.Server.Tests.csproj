<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Serveur</RootNamespace>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Shared/ReadOnlyAccess.cs" Link="Fundus/ReadOnlyAccess.cs" />
    <Compile Include="../../Shared/Families/*.cs" LinkBase="SharedFamilies" />
    <Compile Include="../../Shared/SmsMail/*.cs" LinkBase="SmsMail" />
    <Compile Include="../../Shared/Fundus/*.cs" LinkBase="Fundus" />
    <Compile Include="../../Serveur/Models/*.cs" LinkBase="Models" />
    <Compile Include="../../Serveur/Families/*.cs" LinkBase="Families" />
    <Compile Include="../../Serveur/Pages/Families.cshtml.cs" Link="Pages/Families.cshtml.cs" />
    <Content Include="../../Serveur/Pages/Families.cshtml" Link="Pages/Families.cshtml" />
    <Compile Include="../../Serveur/Pages/Clients.cshtml.cs" Link="Pages/Clients.cshtml.cs" />
    <Content Include="../../Serveur/Pages/Clients.cshtml" Link="Pages/Clients.cshtml" />
    <Compile Include="../../Serveur/ClientUpdate/*.cs" LinkBase="ClientUpdate" />
    <Compile Include="../../Shared/ClientUpdate/*.cs" LinkBase="SharedClientUpdate" />
    <Content Include="../../Serveur/Pages/_ViewImports.cshtml" Link="Pages/_ViewImports.cshtml" />
    <Compile Include="../../Serveur/Fundus/*.cs" LinkBase="ServerFundus" />
    <Compile Include="../../Serveur/Registry/*.cs" LinkBase="Registry" />
    <Compile Include="../../Serveur/Startup/*.cs" Exclude="../../Serveur/Startup/StartupFailure.cs" LinkBase="Startup" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="System.Data.OleDb" Version="8.0.0" />
    <PackageReference Include="RtfPipe" Version="2.0.7677.4303" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>
</Project>
