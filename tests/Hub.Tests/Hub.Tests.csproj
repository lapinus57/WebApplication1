<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Serveur</RootNamespace>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Shared/ReadOnlyAccess.cs" Link="Fundus/ReadOnlyAccess.cs" />
    <Compile Include="../../Shared/Fundus/*.cs" LinkBase="Fundus" />
    <Compile Include="../../Serveur/Models/*.cs" LinkBase="Models" />
    <Compile Include="../../Serveur/Hubs/*.cs" LinkBase="Hubs" />
    <Compile Include="../../Serveur/Fundus/*.cs" Exclude="../../Serveur/Fundus/FoAccessReader.cs" LinkBase="Fundus" />
    <Compile Include="../../Serveur/Registry/*.cs" LinkBase="Registry" />
    <Compile Include="../../Serveur/Startup/StationAccess.cs" Link="Startup/StationAccess.cs" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.0" />
    <PackageReference Include="System.Data.OleDb" Version="8.0.0" />
    <PackageReference Include="RtfPipe" Version="2.0.7677.4303" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>
</Project>
